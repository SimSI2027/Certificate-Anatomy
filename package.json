{
  "name": "certificate-anatomy",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive, motion-led anatomy of a Certificate Signing Request and the certificate issued from it.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "fixtures:generate": "node scripts/fixtures/generate.mjs",
    "fixtures:validate": "node scripts/validation/validate-fixtures.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "smoke:pages": "node scripts/smoke/pages-smoke.mjs",
    "film:stills": "node scripts/film/render.mjs --stills",
    "film:render": "node scripts/film/render.mjs --video",
    "companion": "node scripts/companion/native-viewer.mjs"
  },
  "devDependencies": {
    "@fontsource/martian-mono": "5.3.0",
    "@fontsource/schibsted-grotesk": "5.3.0",
    "@playwright/test": "1.64.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
